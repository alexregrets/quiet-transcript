# Required for real desktop transcription. Loaded by Tauri from the repo-root .env.
# Never expose this as a VITE_* or NEXT_PUBLIC_* variable.
GLADIA_API_KEY=

# Required for desktop Supabase Auth and cloud history.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional for the future web app. Not used by the current desktop MVP.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional desktop/local demo mode. Set to true only for UI demos without API calls.
VITE_DEMO_MODE=false

# Optional Telegram bot workspace.
TELEGRAM_BOT_TOKEN=

# Optional. Where the bot stores each user's own Gladia key (chmod 0600).
# Defaults to .bot-keys.json next to this file.
BOT_KEYSTORE_PATH=

# Optional. Path to yt-dlp for the bot. The server installs it on PATH, so this is only
# needed on a dev machine — point it at the copy the desktop app bundles:
# YTDLP_PATH=apps/desktop/src-tauri/resources/yt-dlp.exe
YTDLP_PATH=
