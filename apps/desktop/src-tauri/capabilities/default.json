{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal app permissions for the transcription MVP.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:scope-home-recursive",
    "core:path:default",
    "core:window:allow-set-size"
  ]
}
