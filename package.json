{
  "name": "bilingual-transcriber",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual desktop and web transcription MVP.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:desktop": "pnpm --filter @transcriber/desktop tauri:dev",
    "dev:web": "pnpm --filter @transcriber/web dev",
    "dev:bot": "pnpm --filter @transcriber/bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
